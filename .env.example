# LLM connection for the demo agent (drasi-agent). Copy to .env (untracked)
# and fill in ONE of the blocks below. Real environment variables always win
# over this file. With no configuration at all, the agent runs its
# deterministic policy brain — the demo still works end to end.

# --- Anthropic API (zero-config path; only the key is needed) --------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Claude in Microsoft Foundry (Anthropic wire dialect) ------------------
# LLM_PROVIDER=anthropic
# LLM_CHAT_URL=https://<your-resource>.services.ai.azure.com/anthropic/v1/messages
# LLM_API_KEY=<foundry-api-key>
# LLM_MODEL=claude-sonnet-5

# --- Azure OpenAI / any OpenAI-compatible endpoint (chat completions) ------
# Paste the FULL chat-completions URL from the Azure portal, including any
# ?api-version=... query string — URL shapes vary by deployment kind.
# LLM_PROVIDER=openai
# LLM_CHAT_URL=https://<your-resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2025-04-01-preview
# LLM_API_KEY=<azure-api-key>
# LLM_MODEL=<deployment-or-model-name>

# --- Azure OpenAI v1 Responses API (gpt-5.x deployments) -------------------
# Auto-detected when the URL path ends in /responses; LLM_PROVIDER=openai works.
# LLM_PROVIDER=openai
# LLM_CHAT_URL=https://<your-resource>.openai.azure.com/openai/v1/responses
# LLM_API_KEY=<azure-api-key>
# LLM_MODEL=<deployment name, e.g. gpt-5.4>
